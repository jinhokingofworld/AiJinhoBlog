NEXT_PUBLIC_APP_NAME=AiJinhoBlog
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=mysql://aijinho:aijinho_password@localhost:3306/aijinhoblog
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=aijinhoblog
MYSQL_USER=aijinho
MYSQL_PASSWORD=aijinho_password
MYSQL_PORT=3306

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RAG_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=
AI_HTTP_TIMEOUT_MS=10000
AI_HTTP_TOTAL_ATTEMPTS=3
AI_HTTP_RETRY_DELAY_MS=250
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_REQUESTS=10

CHROMA_URL=http://localhost:8000
CHROMA_PORT=8000
CHROMA_COLLECTION=blog_posts

# Server-wide Dropbox OAuth app. Users only log in to Dropbox and approve access.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_OAUTH_REDIRECT_URI=http://localhost:3000/api/me/connections/dropbox/callback
DROPBOX_OAUTH_SCOPES=files.metadata.read files.content.read

# Encrypts user-owned external provider tokens at rest.
EXTERNAL_CONNECTION_ENCRYPTION_KEY=

# Development-only fallback for the CLI sync script.
DROPBOX_ACCESS_TOKEN=

AIJINHOBLOG_MCP_OWNER_USERNAME=
AIJINHOBLOG_MCP_OWNER_EMAIL=
AIJINHOBLOG_MCP_OWNER_ID=
