{
  "name": "aijinho-blog-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix aijinhoblog run dev",
    "build": "npm --prefix aijinhoblog run build",
    "start": "npm --prefix aijinhoblog run start",
    "lint": "npm --prefix aijinhoblog run lint",
    "format": "aijinhoblog/node_modules/.bin/prettier . --write",
    "format:check": "aijinhoblog/node_modules/.bin/prettier . --check",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:config": "docker compose config",
    "ci": "npm ci && npm --prefix aijinhoblog ci && npm run lint && npm run format:check && npm run build",
    "install:app": "npm --prefix aijinhoblog install",
    "install:all": "npm install && npm --prefix aijinhoblog install"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "chromadb": "^3.4.3"
  }
}
