{
  "name": "aijinho-blog-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix aijinhoblog run dev",
    "build": "npm --prefix aijinhoblog run build",
    "start": "npm --prefix aijinhoblog run start",
    "lint": "npm --prefix aijinhoblog run lint",
    "test": "npm --prefix aijinhoblog run test",
    "audit": "npm run audit:root && npm run audit:app",
    "audit:app": "npm --prefix aijinhoblog audit --audit-level=high",
    "audit:root": "npm audit --audit-level=high",
    "prisma:generate": "npm --prefix aijinhoblog run prisma:generate",
    "prisma:validate": "npm --prefix aijinhoblog run prisma:validate",
    "prisma:migrate": "npm --prefix aijinhoblog run prisma:migrate",
    "prisma:migrate:dev": "npm --prefix aijinhoblog run prisma:migrate:dev",
    "ai:backfill": "npm --prefix aijinhoblog run ai:backfill --",
    "format": "aijinhoblog/node_modules/.bin/prettier . --write",
    "format:check": "aijinhoblog/node_modules/.bin/prettier . --check",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:config": "docker compose config",
    "ci": "npm ci && npm --prefix aijinhoblog ci && npm run audit && npm run prisma:validate && npm run prisma:generate && npm run lint && npm run format:check && npm run test && npm run build",
    "install:app": "npm --prefix aijinhoblog install",
    "install:all": "npm install && npm --prefix aijinhoblog install"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "chromadb": "^3.4.3"
  }
}
